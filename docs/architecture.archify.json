        "id": "catalog-path",
        "label": "How the catalog fills",
        "focus": [
          "stevedore",
          "media",
          "postgres",
          "metadata",
          "subs"
        ],
        "note": "A scheduled sweep walks each library root, probes files, enriches from metadata providers and writes rows."
      },
      {
        "id": "resume-path",
        "label": "Cross-device resume",
        "focus": [
          "api",
          "postgres",
          "beacon",
          "web",
          "mobile"
        ],
        "note": "Progress writes become Postgres NOTIFY events that reach other devices as server-sent events."
      }
