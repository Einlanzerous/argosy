# Go
/bin/
/tmp/
*.test
*.out

# Node / web
node_modules/
.vite/
*.local

# Built SPA — embedded into the Go binary at build time; keep the placeholder
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local sample media (don't commit binaries)
/deploy/sample-media/*
!/deploy/sample-media/.gitkeep

# Local test media / images dropped at the repo root (never commit binaries)
/*.mkv
/*.mp4
/*.mov
/*.avi
/*.webm
/*.png
/*.jpg
/*.jpeg

# Local agent workspace — except settings.json (carries the graphify grep-nudge hook)
.claude/*
!.claude/settings.json

# Knowledge graph — large generated files stay local; cache + report are committed
graphify-out/graph.html
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*
graphify-out/20*/
